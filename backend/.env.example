# ---- App ----
NODE_ENV=development
PORT=3002
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3002,http://localhost:19006

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=joblinxs
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ---- Tokens ----
EMAIL_VERIFICATION_TOKEN_TTL_MIN=1440
PASSWORD_RESET_TOKEN_TTL_MIN=30

# ---- ToS ----
CURRENT_TOS_VERSION=1.0

# ---- Rate limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# ---- Mail (SMTP via nodemailer; falls back to console logging if MAIL_HOST is empty) ----
MAIL_FROM=JobLinxs <no-reply@joblinxs.com>
MAIL_PROVIDER=console
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me

# ---- Frontend URLs (used in email links) ----
WEB_APP_URL=http://localhost:3002

# ---- Firebase Admin (real-time chat mirror + FCM push; optional — app boots
# fine without it, these features just stay disabled) ----
# Paste the full service-account JSON (Firebase Console > Project Settings >
# Service Accounts > Generate new private key) as a single-line string.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Anthropic (Claude API for AI Recruiter match scoring/shortlisting;
# optional — without it the heuristic scorer is used instead, and the SA's
# platform config "AI provider" must also be set to "anthropic" to opt in) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
